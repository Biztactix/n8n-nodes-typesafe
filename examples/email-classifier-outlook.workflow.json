{
  "name": "Email classifier — Outlook (TypeSafe AI)",
  "nodes": [
    {
      "parameters": {
        "authentication": "microsoftOutlookOAuth2Api",
        "pollTimes": { "item": [ { "mode": "everyMinute" } ] },
        "event": "messageReceived",
        "output": "simple",
        "filters": { "readStatus": "unread" },
        "options": {}
      },
      "name": "Microsoft Outlook Trigger",
      "type": "n8n-nodes-base.microsoftOutlookTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "systemOne",
        "stateType": "text",
        "stateText": "=Subject: {{ $json.subject }}\n\n{{ $json.bodyPreview }}",
        "model": "",
        "questions": {
          "choice": [
            {
              "name": "category",
              "instructions": "Which team should handle this email?",
              "labels": "billing = invoices, payments, refunds, subscriptions\nsupport = technical problems, outages, how-to questions\nsales = quotes, new business, pricing enquiries\nspam = marketing, newsletters, unsolicited offers"
            }
          ],
          "score": [
            {
              "name": "urgency",
              "instructions": "How urgent is this email?",
              "rubric": "can wait a week\nthis week\ntoday\nright now"
            }
          ],
          "noul": [
            {
              "name": "needsReply",
              "instructions": "Does this email need a human reply?",
              "whenTrue": "A person must respond to the sender.",
              "whenFalse": "No response is needed."
            }
          ]
        },
        "options": {}
      },
      "name": "TypeSafe AI",
      "type": "@biztactix/n8n-nodes-typesafe.typeSafe",
      "typeVersion": 1,
      "position": [260, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 }, "conditions": [ { "id": "rule-billing", "leftValue": "={{ $json.results.category }}", "rightValue": "billing", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "renameOutput": true, "outputKey": "billing" },
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 }, "conditions": [ { "id": "rule-support", "leftValue": "={{ $json.results.category }}", "rightValue": "support", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "renameOutput": true, "outputKey": "support" },
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 }, "conditions": [ { "id": "rule-sales", "leftValue": "={{ $json.results.category }}", "rightValue": "sales", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "renameOutput": true, "outputKey": "sales" },
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 }, "conditions": [ { "id": "rule-spam", "leftValue": "={{ $json.results.category }}", "rightValue": "spam", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "renameOutput": true, "outputKey": "spam" }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "unmatched" }
      },
      "name": "Route by category",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [520, 0]
    },
    { "parameters": {}, "name": "Billing", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [780, -260] },
    { "parameters": {}, "name": "Support", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [780, -120] },
    { "parameters": {}, "name": "Sales", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [780, 20] },
    { "parameters": {}, "name": "Spam", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [780, 160] },
    { "parameters": {}, "name": "Unmatched", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [780, 300] }
  ],
  "connections": {
    "Microsoft Outlook Trigger": { "main": [ [ { "node": "TypeSafe AI", "type": "main", "index": 0 } ] ] },
    "TypeSafe AI": { "main": [ [ { "node": "Route by category", "type": "main", "index": 0 } ] ] },
    "Route by category": {
      "main": [
        [ { "node": "Billing", "type": "main", "index": 0 } ],
        [ { "node": "Support", "type": "main", "index": 0 } ],
        [ { "node": "Sales", "type": "main", "index": 0 } ],
        [ { "node": "Spam", "type": "main", "index": 0 } ],
        [ { "node": "Unmatched", "type": "main", "index": 0 } ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
