{
  "name": "@biztactix/n8n-nodes-typesafe",
  "version": "0.1.0",
  "description": "n8n community node for TypeSafe AI: ask yes/no, choice and score questions about any text or JSON (System One)",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "typesafe",
    "typesafe-ai",
    "classification"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Biztactix/n8n-nodes-typesafe",
  "author": {
    "name": "Biztactix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Biztactix/n8n-nodes-typesafe.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/copy-icons.mjs",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix",
    "test": "rimraf dist-test && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "n8n:dev": "node scripts/n8n-dev.mjs",
    "prepublishOnly": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TypeSafeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TypeSafe/TypeSafe.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "n8n-workflow": "^1.82.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
